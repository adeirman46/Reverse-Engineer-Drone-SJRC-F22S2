# Pindad UGV - UAV ground station on the DGX Spark as a headless relay (RTSP video + MAVLink), at boot.
# Edit User=, WorkingDirectory=, ExecStart (python of your venv) and the --mavlink address, then:
#   sudo cp pindad-gcs.service /etc/systemd/system/ && sudo systemctl enable --now pindad-gcs
[Unit]
Description=Pindad UGV - UAV ground station (RTSP + MAVLink)
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/Reverse-Engineer-Drone-SJRC-F22S2/dgx-spark
ExecStart=/home/YOUR_USER/venv-gcs/bin/python -m pindad_gcs --link tcp://auto --headless --mavlink udpout:192.168.1.50:14550
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

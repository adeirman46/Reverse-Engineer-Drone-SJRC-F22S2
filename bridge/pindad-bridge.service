# USB bridge for the SJRC remote (Raspberry Pi in USB gadget mode), started at boot.
# Edit User= and the paths, then:
#   sudo cp pindad-bridge.service /etc/systemd/system/ && sudo systemctl enable --now pindad-bridge
[Unit]
Description=Pindad UGV - UAV USB bridge for the SJRC remote
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Reverse-Engineer-Drone-SJRC-F22S2/dgx-spark
ExecStartPre=+/home/pi/Reverse-Engineer-Drone-SJRC-F22S2/bridge/setup_gadget.sh pi
ExecStart=/usr/bin/python3 -m pindad_gcs.bridge
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
